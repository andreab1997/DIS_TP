Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ExportHPL4", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i0_", ",", "i1_", ",", "i2_", ",", "i3_"}], "}"}], ",", 
     "xvect_", ",", "outputDir_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Hlist", ",", "outputFilename"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Compute", " ", "HPL", " ", "values"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Hlist", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"HPL", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i0", ",", "i1", ",", "i2", ",", "i3"}], "}"}], ",", 
            "#"}], "]"}], "]"}], "&"}], "/@", "xvect"}]}], " ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Generate", " ", "filename"}], ",", 
        RowBox[{
        "replacing", " ", "\"\<-\>\"", " ", "with", " ", "\"\<m\>\""}]}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"outputFilename", "=", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"outputDir", ",", 
         RowBox[{"\"\<HPL_\>\"", "<>", 
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"ToString", "/@", 
             RowBox[{"{", 
              RowBox[{"i0", ",", "i1", ",", "i2", ",", "i3"}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"\"\<-\>\"", "->", "\"\<m\>\""}], "}"}]}], "]"}], "<>", 
          "\"\<.txt\>\""}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Export", " ", "to", " ", "file"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{"outputFilename", ",", "\[IndentingNewLine]", 
        RowBox[{"{", "Hlist", "}"}], ",", "\[IndentingNewLine]", 
        "\"\<Table\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<FieldSeparators\>\"", "->", "\"\< \>\""}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Return", " ", "confirmation", " ", "message"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Exported to: \>\"", ",", "outputFilename"}], "]"}], 
      ";"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.955030331583417*^9, 3.955030367113659*^9}, {
